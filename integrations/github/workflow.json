{
  "schema_version": "1.0",
  "id": "github-quality-pilot",
  "mode": "quality",
  "summary": "Verify and review a fixed PR against explicit host-supplied criteria, then consolidate retained evidence.",
  "inputs": ["request", "change-set", "specification", "test-plan"],
  "steps": [
    {
      "id": "verify",
      "skill": "sf-verify-change",
      "needs": [],
      "bindings": {
        "change-set": "input:change-set",
        "test-plan": "input:test-plan",
        "specification": "input:specification"
      }
    },
    {
      "id": "review",
      "skill": "sf-review-change",
      "needs": ["verify"],
      "accept_statuses": {"verify": ["passed", "failed", "blocked", "inconclusive"]},
      "bindings": {
        "change-set": "input:change-set",
        "specification": "input:specification",
        "verification-report": "step:verify:verification-report"
      }
    },
    {
      "id": "consolidate",
      "skill": "sf-consolidate-quality",
      "needs": ["verify", "review"],
      "accept_statuses": {
        "verify": ["passed", "failed", "blocked", "inconclusive"],
        "review": ["passed", "failed", "blocked", "inconclusive"]
      },
      "bindings": {
        "request": "input:request",
        "change-set": "input:change-set",
        "specification": "input:specification",
        "verification-report": "step:verify:verification-report",
        "review-report": "step:review:review-report"
      }
    }
  ],
  "completion": ["consolidate"]
}
