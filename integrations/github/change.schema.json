{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded sf-build-change response; identity and evidence are checked by the host",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "subject",
    "status",
    "summary",
    "criteria_addressed",
    "behavior_changes",
    "checks_run",
    "remaining_work",
    "edits"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "input_digest",
        "environment"
      ],
      "properties": {
        "revision": {
          "type": "string"
        },
        "input_digest": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        }
      }
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "inconclusive"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "criteria_addressed": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "behavior_changes": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "checks_run": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "observed"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "observed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "remaining_work": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "description": "Unmet acceptance criteria or implementation blockers only. A passing submission MUST have an empty list; any item blocks draft PR publication, even if the agent labels it advisory."
    },
    "edits": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "content": {
            "type": "string",
            "maxLength": 32768
          }
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symptom",
        "expected_behavior",
        "reproduction",
        "causal_mechanism",
        "repair_direction",
        "regression_check",
        "observations",
        "hypotheses",
        "experiments"
      ],
      "properties": {
        "symptom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "expected_behavior": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "reproduction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "causal_mechanism": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "repair_direction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "regression_check": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "experiments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "limitations": {
      "description": "Optional non-blocking cautions and residual risks for the human/Quality Factory reviewers. Does not replace remaining_work, does not grant authorization, and cannot excuse unmet acceptance criteria.",
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  }
}
