{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Untrusted Agentic Workflows review submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "subject", "status", "summary", "criteria", "engineering_quality", "findings", "limitations"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "input_digest", "environment"],
      "properties": {
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "environment": {"type": "string", "minLength": 1}
      }
    },
    "status": {"$ref": "#/$defs/status"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "engineering_quality": {"type": "string", "minLength": 1, "maxLength": 12000},
    "criteria": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "detail", "evidence"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "status": {"$ref": "#/$defs/status"},
          "detail": {"type": "string", "minLength": 1, "maxLength": 4000},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "findings": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "severity", "blocking", "disposition", "mechanism", "evidence"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "severity": {"enum": ["critical", "high", "medium", "low", "informational"]},
          "blocking": {"type": "boolean"},
          "disposition": {"const": "open"},
          "mechanism": {"type": "string", "minLength": 1, "maxLength": 4000},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "limitations": {
      "type": "array", "maxItems": 100, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    }
  },
  "$defs": {
    "status": {"enum": ["passed", "failed", "blocked", "inconclusive"]},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "evidence": {
      "type": "array", "uniqueItems": true, "maxItems": 2,
      "items": {"enum": ["candidate-diff", "verification-report"]}
    }
  }
}
