{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sfstack:comparative-trials:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trials"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "trial_id",
          "variant",
          "agent",
          "environment",
          "correct",
          "unsupported_claims",
          "human_interventions",
          "elapsed_seconds",
          "cost_usd",
          "recovered",
          "safety_violations"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "trial_id": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "enum": [
              "bare",
              "skills",
              "contracts"
            ]
          },
          "agent": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "correct": {
            "type": "boolean"
          },
          "unsupported_claims": {
            "type": "integer",
            "minimum": 0
          },
          "human_interventions": {
            "type": "integer",
            "minimum": 0
          },
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0
          },
          "recovered": {
            "type": "boolean"
          },
          "safety_violations": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
