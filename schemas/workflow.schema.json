{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sfstack:workflow:1.0",
  "title": "sfstack workflow",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "skill": {
            "type": "string",
            "pattern": "^sf-"
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "bindings": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^(input:[a-z0-9-]+|step:[a-z0-9-]+:[a-z0-9-]+)$"
            },
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "max_work_items": {
            "type": "integer",
            "minimum": 1
          },
          "accept_statuses": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "passed",
                  "failed",
                  "blocked",
                  "inconclusive"
                ]
              }
            }
          }
        },
        "required": [
          "id",
          "skill",
          "needs",
          "bindings"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "completion": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "mode": {
      "enum": [
        "software",
        "quality"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "summary",
    "inputs",
    "steps",
    "completion"
  ],
  "additionalProperties": false
}
