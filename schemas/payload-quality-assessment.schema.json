{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sfstack:payload:quality-assessment:1.0",
  "title": "Quality assessment core payload",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "target",
    "reports",
    "coverage",
    "findings",
    "limitations",
    "independence",
    "recommendations",
    "remediation_authorized"
  ],
  "properties": {
    "target": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "revision"
      ],
      "properties": {
        "kind": {
          "enum": [
            "snapshot",
            "pull-request",
            "external-change"
          ]
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "artifact_type",
          "status",
          "evidence_id"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "inconclusive"
            ]
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "coverage": {
      "type": "object",
      "required": [
        "required",
        "evaluated",
        "omitted"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evaluated": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "omitted": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_report",
          "blocking",
          "disposition",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_report": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "disposition": {
            "enum": [
              "open",
              "resolved",
              "rejected",
              "accepted-risk"
            ]
          },
          "severity": {
            "type": "string"
          },
          "mechanism": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "additionalProperties": true
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "independence": {
      "type": "object",
      "required": [
        "established",
        "basis"
      ],
      "properties": {
        "established": {
          "type": "boolean"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "remediation_authorized": {
      "const": false
    }
  }
}
