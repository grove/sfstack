{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sfstack:payload:verification-report:1.0",
  "title": "Core verification-report payload (additional skill-specific fields permitted)",
  "type": "object",
  "required": [
    "executed_count",
    "required_count",
    "failed_count",
    "skipped_required"
  ],
  "properties": {
    "candidate_revision": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "executed_count": {
      "type": "integer",
      "minimum": 0
    },
    "required_count": {
      "type": "integer",
      "minimum": 1
    },
    "failed_count": {
      "type": "integer",
      "minimum": 0
    },
    "skipped_required": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "excluded_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "integrity_findings": {
      "type": "array"
    },
    "remaining_risks": {
      "type": "array"
    },
    "check_results": {
      "type": "array"
    },
    "criteria_coverage": {
      "type": [
        "array",
        "object"
      ]
    }
  },
  "additionalProperties": true
}
