{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sfstack:evidence-impact:1.0",
  "title": "Evidence dependency impact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "before",
    "after",
    "complete_inventory",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "before": {
      "$ref": "#/$defs/snapshot"
    },
    "after": {
      "$ref": "#/$defs/snapshot"
    },
    "complete_inventory": {
      "type": "boolean"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "depends_on",
          "needs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "needs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "inputs"
      ],
      "properties": {
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "input_digest",
            "environment"
          ],
          "properties": {
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "input_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "environment": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
