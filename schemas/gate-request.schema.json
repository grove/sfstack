{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sfstack:gate-request:1.0",
  "title": "sfstack gate-request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "effect": {
      "enum": [
        "workspace.modify",
        "tracker.modify",
        "review.publish",
        "integration.modify",
        "release.publish",
        "deployment.modify",
        "data.modify",
        "external.communicate"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "revision",
        "input_digest",
        "environment"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "effect",
    "scope",
    "subject",
    "artifacts"
  ],
  "additionalProperties": false
}
