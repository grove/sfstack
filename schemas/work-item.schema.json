{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sfstack:work-item:1.0",
  "title": "sfstack work-item",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "state": {
      "enum": [
        "queued",
        "ready",
        "active",
        "blocked",
        "review",
        "done",
        "cancelled"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "native_id": {
          "type": "string",
          "minLength": 1
        },
        "native_state": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "adapter",
        "native_id",
        "native_state"
      ],
      "additionalProperties": false
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "description",
    "state",
    "version",
    "dependencies",
    "acceptance",
    "source",
    "links"
  ],
  "additionalProperties": false
}
