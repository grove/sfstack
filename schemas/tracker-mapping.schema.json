{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sfstack:tracker-mapping:1.0",
  "title": "sfstack tracker mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "fields",
    "states"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "fields": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "state",
        "version",
        "dependencies",
        "acceptance",
        "links"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:[.][A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "title": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:[.][A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "description": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:[.][A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:[.][A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:[.][A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "dependencies": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:[.][A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "acceptance": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:[.][A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "links": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:[.][A-Za-z_][A-Za-z0-9_]*)*$"
        }
      }
    },
    "states": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": [
          "queued",
          "ready",
          "active",
          "blocked",
          "review",
          "done",
          "cancelled"
        ]
      }
    }
  }
}
